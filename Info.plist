<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Marlin DVR TV shows the weather and radar for where this Apple TV is. The location is used once, on the device, and is never sent to the DVR server.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.marlin1111.MarlinDVRTV</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>marlindvr</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
